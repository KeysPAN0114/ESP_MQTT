# ESP32/ESP-IDF Build Files and Directories

# Build directories
**/build/
**/build_*/

# Compiled object files
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# Executables and binaries
*.elf
*.bin
*.hex
*.map
*.out

# ESP-IDF specific files
sdkconfig
sdkconfig.old
sdkconfig.defaults
sdkconfig.defaults.*

