CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Dependencies lock files
dependencies.lock

# Partition table files
partition_table/
*.bin

# Flasher arguments
flash_args
flash_args.in
flash_app_args
flash_bootloader_args
flash_project_args
flasher_args.json
flasher_args.json.in

