kconfigs_projbuild.in
kconfigs.in

# Linker files
ldgen_libraries
ldgen_libraries.in

# Assembly files generated
*.S
*.s

# Python compiled files
__pycache__/
*.py[cod]
*$py.class

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
