import { Button, VerticalBox, HorizontalBox, GroupBox, LineEdit, Switch } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "ESP MQTT Client";
    preferred-width: 820px;
    preferred-height: 560px;
    background: #f0f4f8;

    // MQTT 状态属性
    in-out property <bool> is-connected: false;
    in-out property <string> connection-status: "未连接";
    in-out property <string> broker-info: "";
    in-out property <string> last-topic: "";
    in-out property <string> last-message: "";
    in-out property <int> message-count: 0;

    // 发布相关属性
    in-out property <string> publish-topic: "test/topic";
    in-out property <string> publish-message: "Hello from Slint!";
    in-out property <int> publish-count: 0;

    // 回调：发布消息到 MQTT（参数：主题、消息内容）
    callback publish-clicked(string, string);

    // 灯光控制属性
    in-out property <bool> light-on: false;
    in-out property <bool> light-pending: false;
    callback light-toggled(bool);

    // 温湿度属性
    in-out property <string> temperature: "--";
    in-out property <string> humidity: "--";
    in-out property <string> sensor-topic: "";

    // 原有的计数器
    in-out property <int> counter: 42;
    callback request-increase-value();

    VerticalLayout {
        spacing: 0px;

        // ==================== 顶部标题栏 ====================
        Rectangle {
            height: 44px;
            background: #1e293b;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                Text {
                    text: "📡  ESP MQTT Client";
                    font-size: 16px;
                    font-weight: 700;
                    color: #f8fafc;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.is-connected ? #22c55e : #ef4444;
                    }
                    Text {
                        text: root.is-connected ? "Connected" : "Disconnected";
                        font-size: 12px;
                        color: root.is-connected ? #86efac : #fca5a5;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ==================== 主内容区域 ====================
        HorizontalLayout {
            spacing: 12px;
            padding: 12px;

            // -------- 左列：状态 + 灯光 + 传感器 --------
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;

                // MQTT 连接状态卡片
                Rectangle {
                    background: white;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: "MQTT 连接状态";
                            font-size: 13px;
                            font-weight: 600;
                            color: #64748b;
                        }

                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "状态:";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.connection-status;
                                font-size: 12px;
                                font-weight: 600;
                                color: root.is-connected ? #16a34a : #dc2626;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "服务器:";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.broker-info;
                                font-size: 11px;
                                color: #475569;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "消息数:";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "\{root.message-count}";
                                font-size: 12px;
                                font-weight: 700;
                                color: #1e293b;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 灯光控制卡片
                Rectangle {
                    background: white;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Text {
                            text: "💡 灯光控制";
                            font-size: 13px;
                            font-weight: 600;
                            color: #64748b;
                        }

                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;

                            // 灯光状态指示灯
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: root.light-on ? #fbbf24 : #cbd5e1;
                                border-width: 3px;
                                border-color: root.light-on ? #f59e0b : #94a3b8;

                                // 发光效果
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: root.light-on ? #fef3c7 : transparent;
                                    x: 7px;
                                    y: 7px;
                                }
                            }

                            Text {
                                text: root.light-on ? "灯光: 已开启" : "灯光: 已关闭";
                                font-size: 15px;
                                font-weight: 700;
                                color: root.light-on ? #d97706 : #64748b;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            Switch {
                                checked: root.light-on;
                                text: root.light-pending ? "确认中..." : (root.light-on ? "ON" : "OFF");
                                enabled: !root.light-pending;
                                toggled => {
                                    root.light-toggled(!root.light-on);
                                }
                            }
                        }
                    }
                }

                // 温湿度监控卡片
                Rectangle {
                    background: white;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "🌡️ 温湿度监控";
                            font-size: 13px;
                            font-weight: 600;
                            color: #64748b;
                        }

                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: stretch;

                            // 温度卡片
                            Rectangle {
                                background: #fef2f2;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #fecaca;
                                height: 72px;
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    spacing: 4px;
                                    padding: 10px;
                                    alignment: center;

                                    Text {
                                        text: "Temp";
                                        font-size: 11px;
                                        color: #f87171;
                                        horizontal-alignment: center;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: "\{root.temperature} °C";
                                        font-size: 24px;
                                        font-weight: 800;
                                        color: #dc2626;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // 湿度卡片
                            Rectangle {
                                background: #eff6ff;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #bfdbfe;
                                height: 72px;
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    spacing: 4px;
                                    padding: 10px;
                                    alignment: center;

                                    Text {
                                        text: "Humi";
                                        font-size: 11px;
                                        color: #60a5fa;
                                        horizontal-alignment: center;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: "\{root.humidity} %";
                                        font-size: 24px;
                                        font-weight: 800;
                                        color: #2563eb;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.sensor-topic != "" : Text {
                            text: "数据来源: \{root.sensor-topic}";
                            font-size: 10px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // -------- 右列：接收消息 + 发布消息 + 计数器 --------
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;

                // 接收到的消息卡片
                Rectangle {
                    background: white;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "📥 接收到的消息";
                            font-size: 13px;
                            font-weight: 600;
                            color: #64748b;
                        }

                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "主题:";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Rectangle {
                                background: #f8fafc;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                height: 26px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.last-topic;
                                    font-size: 12px;
                                    color: #334155;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    x: 8px;
                                    width: parent.width - 16px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "内容:";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: top;
                                horizontal-stretch: 0;
                            }
                            Rectangle {
                                background: #f8fafc;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                height: 64px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.last-message;
                                    font-size: 12px;
                                    color: #1e293b;
                                    wrap: word-wrap;
                                    x: 10px;
                                    y: 6px;
                                    width: parent.width - 20px;
                                }
                            }
                        }
                    }
                }

                // 发布消息卡片
                Rectangle {
                    background: white;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "📤 发布消息";
                            font-size: 13px;
                            font-weight: 600;
                            color: #64748b;
                        }

                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "主题:";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            LineEdit {
                                text <=> root.publish-topic;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "消息:";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            LineEdit {
                                text <=> root.publish-message;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: space-between;

                            Button {
                                text: "发布到 MQTT";
                                clicked => {
                                    root.publish-clicked(root.publish-topic, root.publish-message);
                                }
                            }
                            Text {
                                text: "已发布: \{root.publish-count}";
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 测试计数器卡片
                Rectangle {
                    background: white;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    vertical-stretch: 0;

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: "Counter: \{root.counter}";
                            font-size: 14px;
                            font-weight: 600;
                            color: #334155;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Increase";
                            clicked => {
                                root.request-increase-value();
                            }
                        }
                    }
                }
            }
        }
    }
}
