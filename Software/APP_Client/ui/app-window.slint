import { Button, VerticalBox, HorizontalBox, GroupBox, LineEdit, Switch } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "ESP MQTT Client";
    preferred-width: 780px;
    preferred-height: 520px;

    // MQTT 状态属性
    in-out property <bool> is-connected: false;
    in-out property <string> connection-status: "未连接";
    in-out property <string> broker-info: "";
    in-out property <string> last-topic: "";
    in-out property <string> last-message: "";
    in-out property <int> message-count: 0;

    // 发布相关属性
    in-out property <string> publish-topic: "test/topic";
    in-out property <string> publish-message: "Hello from Slint!";
    in-out property <int> publish-count: 0;

    // 回调：发布消息到 MQTT（参数：主题、消息内容）
    callback publish-clicked(string, string);

    // 灯光控制属性
    in-out property <bool> light-on: false;
    in-out property <bool> light-pending: false;
    callback light-toggled(bool);

    // 温湿度属性
    in-out property <string> temperature: "--";
    in-out property <string> humidity: "--";
    in-out property <string> sensor-topic: "";

    // 原有的计数器
    in-out property <int> counter: 42;
    callback request-increase-value();

    VerticalBox {
        spacing: 10px;
        padding: 12px;

        // ==================== 上方：两列网格 ====================
        HorizontalBox {
            spacing: 10px;

            // -------- 左列：连接状态 + 灯光控制 --------
            VerticalBox {
                spacing: 10px;
                horizontal-stretch: 1;

                // MQTT 连接状态
                GroupBox {
                    title: "MQTT 连接状态";
                    VerticalBox {
                        spacing: 8px;
                        padding: 6px;

                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "状态:";
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: root.is-connected ? #22c55e : #ef4444;
                            }
                            Text {
                                text: root.connection-status;
                                color: root.is-connected ? #22c55e : #ef4444;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "服务器:";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.broker-info;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "接收消息数:";
                                vertical-alignment: center;
                            }
                            Text {
                                text: "\{root.message-count}";
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 灯光控制
                GroupBox {
                    title: "灯光控制";
                    VerticalBox {
                        spacing: 10px;
                        padding: 6px;
                        alignment: center;

                        HorizontalBox {
                            spacing: 12px;
                            alignment: center;

                            // 灯光状态指示灯
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: root.light-on ? #fbbf24 : #6b7280;
                                border-width: 2px;
                                border-color: root.light-on ? #f59e0b : #9ca3af;

                                // 发光效果
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: root.light-on ? #fef3c7 : transparent;
                                    x: 7px;
                                    y: 7px;
                                }
                            }

                            Text {
                                text: root.light-on ? "灯光: 已开启" : "灯光: 已关闭";
                                font-size: 16px;
                                font-weight: 700;
                                color: root.light-on ? #f59e0b : #6b7280;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalBox {
                            alignment: center;
                            Switch {
                                checked: root.light-on;
                                text: root.light-pending ? "确认中..." : (root.light-on ? "ON" : "OFF");
                                enabled: !root.light-pending;
                                toggled => {
                                    root.light-toggled(!root.light-on);
                                }
                            }
                        }
                    }
                }

                // 温湿度监控
                GroupBox {
                    title: "温湿度监控";
                    VerticalBox {
                        spacing: 8px;
                        padding: 6px;

                        HorizontalBox {
                            spacing: 12px;
                            alignment: center;

                            // 温度卡片
                            Rectangle {
                                background: #fef2f2;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #fecaca;
                                height: 70px;
                                horizontal-stretch: 1;

                                VerticalBox {
                                    spacing: 2px;
                                    padding: 8px;
                                    alignment: center;

                                    Text {
                                        text: "🌡️ 温度";
                                        font-size: 11px;
                                        color: #9ca3af;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "\{root.temperature} ℃";
                                        font-size: 22px;
                                        font-weight: 700;
                                        color: #ef4444;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // 湿度卡片
                            Rectangle {
                                background: #eff6ff;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #bfdbfe;
                                height: 70px;
                                horizontal-stretch: 1;

                                VerticalBox {
                                    spacing: 2px;
                                    padding: 8px;
                                    alignment: center;

                                    Text {
                                        text: "💧 湿度";
                                        font-size: 11px;
                                        color: #9ca3af;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "\{root.humidity} %";
                                        font-size: 22px;
                                        font-weight: 700;
                                        color: #3b82f6;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.sensor-topic != "" : Text {
                            text: "数据来源: \{root.sensor-topic}";
                            font-size: 10px;
                            color: #9ca3af;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // -------- 右列：接收消息 + 发布消息 --------
            VerticalBox {
                spacing: 10px;
                horizontal-stretch: 1;

                // 接收到的消息
                GroupBox {
                    title: "接收到的消息";
                    VerticalBox {
                        spacing: 6px;
                        padding: 6px;

                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "主题:";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.last-topic;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "内容:";
                                vertical-alignment: top;
                            }
                            Rectangle {
                                background: #f3f4f6;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #e5e7eb;
                                height: 60px;
                                Text {
                                    text: root.last-message;
                                    wrap: word-wrap;
                                    x: 8px;
                                    y: 4px;
                                    width: parent.width - 16px;
                                }
                            }
                        }
                    }
                }

                // 发布消息
                GroupBox {
                    title: "发布消息";
                    VerticalBox {
                        spacing: 6px;
                        padding: 6px;

                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "主题:";
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            LineEdit {
                                text <=> root.publish-topic;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: "消息:";
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            LineEdit {
                                text <=> root.publish-message;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;
                            Button {
                                text: "发布到 MQTT";
                                clicked => {
                                    root.publish-clicked(root.publish-topic, root.publish-message);
                                }
                            }
                            Text {
                                text: "已发布: \{root.publish-count}";
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ==================== 底部：测试计数器 ====================
        GroupBox {
            title: "测试计数器";
            HorizontalBox {
                spacing: 12px;
                padding: 6px;

                Text {
                    text: "Counter: \{root.counter}";
                    vertical-alignment: center;
                }
                Button {
                    text: "Increase value";
                    clicked => {
                        root.request-increase-value();
                    }
                }
            }
        }
    }
}
